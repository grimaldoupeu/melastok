# Copia este archivo como .env y completa con los datos de tu proyecto Supabase
# (Dashboard > Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# Opcional: nombre del negocio que aparece en la boleta de WhatsApp
EXPO_PUBLIC_BUSINESS_NAME=Muebles de Melamina
EXPO_PUBLIC_BUSINESS_PHONE=
EXPO_PUBLIC_BUSINESS_ADDRESS=

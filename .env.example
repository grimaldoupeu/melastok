# Copia este archivo como .env y completa los valores.
# Firebase: Consola > Configuración del proyecto > Tus apps > App web > firebaseConfig
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=TU-PROYECTO.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=TU-PROYECTO
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=TU-PROYECTO.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Cloudinary (fotos de productos, plan gratis con upload preset sin firma). Se usa desde la fase 2.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Datos del negocio para la boleta de WhatsApp (opcional)
EXPO_PUBLIC_BUSINESS_NAME=Muebles de Melamina
EXPO_PUBLIC_BUSINESS_PHONE=
EXPO_PUBLIC_BUSINESS_ADDRESS=

# Supabase (backend anterior; se elimina al terminar la migración, fase 7)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

rules_version = '2';

// =====================================================================
//  MelaStock · Reglas de Firestore
//  Fase 1: perfiles y roles. Las demás colecciones se agregan por fase.
//  Desplegar: firebase deploy --only firestore
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------
    function autenticado() {
      return request.auth != null;
    }

    function perfilActual() {
      return get(/databases/$(database)/documents/perfiles/$(request.auth.uid)).data;
    }

    function tienePerfil() {
      return exists(/databases/$(database)/documents/perfiles/$(request.auth.uid));
    }

    function esAdmin() {
      return autenticado() && tienePerfil() && perfilActual().rol == 'admin' && perfilActual().activo == true;
    }

    // Usuario con perfil aprobado por el admin. TODAS las colecciones de datos
    // (productos, ventas, materiales, pedidos, etc.) deben exigir esta función:
    // un perfil pendiente o desactivado no puede leer ni escribir nada fuera
    // de su propio documento en "perfiles".
    function esUsuarioActivo() {
      return autenticado() && tienePerfil() && perfilActual().activo == true;
    }

    function rolValido(rol) {
      return rol in ['admin', 'vendedor'];
    }

    // ------------------------------------------------------------------
    // perfiles/{uid}
    // ------------------------------------------------------------------
    match /perfiles/{uid} {
      // Cada usuario puede leer su propio perfil (para saber si está aprobado).
      // Los demás perfiles solo los leen usuarios activos (nombres de vendedores en ventas, etc.).
      allow read: if autenticado() && (request.auth.uid == uid || esUsuarioActivo());

      // Un usuario puede crear SOLO su propio perfil, SOLO como vendedor y SOLO
      // INACTIVO (pendiente de aprobación). Así, aunque alguien se registre en Auth
      // con el firebaseConfig, no obtiene acceso a nada hasta que el admin lo apruebe.
      // Solo el admin puede crear perfiles con activo == true (Gestionar usuarios).
      allow create: if autenticado()
        && request.resource.data.keys().hasAll(['nombre', 'email', 'rol', 'activo'])
        && request.resource.data.nombre is string
        && request.resource.data.email is string
        && rolValido(request.resource.data.rol)
        && request.resource.data.activo is bool
        && (
          (request.auth.uid == uid && request.resource.data.rol == 'vendedor' && request.resource.data.activo == false)
          || esAdmin()
        );

      // El usuario puede cambiar solo su nombre; el admin puede cambiar nombre, rol y activo
      // (pero no su propio rol ni desactivarse a sí mismo).
      allow update: if autenticado() && (
          (
            request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'actualizadoEn'])
          )
          || (
            esAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'rol', 'activo', 'actualizadoEn'])
            && rolValido(request.resource.data.rol)
            && request.resource.data.activo is bool
            && (request.auth.uid != uid || (request.resource.data.rol == 'admin' && request.resource.data.activo == true))
          )
        );

      allow delete: if esAdmin() && request.auth.uid != uid;
    }

    // ------------------------------------------------------------------
    // Helpers de validación de campos
    // ------------------------------------------------------------------
    function esTextoOpcional(v) {
      return v == null || v is string;
    }

    function esNumeroOpcional(v) {
      return v == null || (v is number && v >= 0);
    }

    function esEnteroNoNegativo(v) {
      return v is int && v >= 0;
    }

    // ------------------------------------------------------------------
    // categorias/{id}  — lectura: usuarios activos; escritura: admin
    // ------------------------------------------------------------------
    function categoriaValida(d) {
      return d.keys().hasOnly(['nombre', 'icono', 'orden'])
        && d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 60
        && d.icono is string
        && d.orden is number;
    }

    match /categorias/{id} {
      allow read: if esUsuarioActivo();
      allow create: if esAdmin() && categoriaValida(request.resource.data);
      allow update: if esAdmin() && categoriaValida(request.resource.data);
      allow delete: if esAdmin();
    }

    // ------------------------------------------------------------------
    // productos/{id}
    //   lectura: usuarios activos
    //   crear / borrar / editar datos: admin
    //   el stock SOLO cambia: (a) por el admin, (b) por una venta de un
    //   usuario activo, que únicamente puede DISMINUIRLO (fase 3).
    // ------------------------------------------------------------------
    function productoValido(d) {
      return d.keys().hasOnly(['nombre', 'descripcion', 'categoriaId', 'categoriaNombre', 'precio', 'costo',
                               'stock', 'stockMinimo', 'fotoUrl', 'activo', 'creadoEn', 'actualizadoEn'])
        && d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 120
        && esTextoOpcional(d.descripcion)
        && esTextoOpcional(d.categoriaId)
        && esTextoOpcional(d.categoriaNombre)
        && d.precio is number && d.precio >= 0
        && esNumeroOpcional(d.costo)
        && esEnteroNoNegativo(d.stock)
        && esEnteroNoNegativo(d.stockMinimo)
        && esTextoOpcional(d.fotoUrl)
        && d.activo is bool;
    }

    match /productos/{id} {
      allow read: if esUsuarioActivo();
      allow create: if esAdmin() && productoValido(request.resource.data);
      allow delete: if esAdmin();
      allow update: if productoValido(request.resource.data) && (
          esAdmin()
          || (
            // Venta: solo baja el stock, nunca por debajo de 0, sin tocar otros campos
            esUsuarioActivo()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'actualizadoEn'])
            && request.resource.data.stock < resource.data.stock
            && request.resource.data.stock >= 0
          )
        );
    }

    // ------------------------------------------------------------------
    // Resto de colecciones: por defecto denegado hasta su fase.
    // Al agregarlas, toda lectura/escritura debe partir de esUsuarioActivo()
    // (o esAdmin(), que ya implica activo == true).
    // ------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

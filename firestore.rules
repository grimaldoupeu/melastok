rules_version = '2';

// =====================================================================
//  MelaStock · Reglas de Firestore
//  Desplegar: firebase deploy --only firestore
//  Probar:    npm run test:reglas   (emulador, ver scripts/test-reglas.ts)
//
//  Límite de Firestore: máximo 10 lecturas de documentos (get/exists/
//  getAfter/existsAfter) por operación y 20 por transacción completa.
//  Por eso cada regla lee lo mínimo y una venta admite MAX_ITEMS_VENTA
//  productos distintos (mismo valor en src/services/ventas-core.ts).
//
//  Resumen de permisos (todo exige sesión y perfil APROBADO, salvo leer el
//  propio perfil; un perfil pendiente o desactivado no ve nada más):
//
//  | colección       | leer   | crear / modificar                                  |
//  | perfiles        | propio / activos | propio como vendedor inactivo; admin aprueba, cambia rol |
//  | categorias      | activo | admin                                              |
//  | productos       | activo | admin (datos); stock solo con movimiento de kardex |
//  | materiales      | activo | admin (datos); stock solo con movimiento de kardex |
//  | proveedores     | activo | admin                                              |
//  | movimientos     | activo | según tipo: venta/ingreso/consumo (activo), ajuste/anulación (admin); inmutable |
//  | clientes        | activo | activo                                             |
//  | ventas          | activo | activo (transacción completa); cancelar: admin; nunca se borran |
//  | pedidos         | activo | activo; cancelar y cambiar precio: admin; nunca se borran |
//  | contadores      | activo | solo +1 junto con su venta / pedido; serie: admin  |
//  | resumen_diario  | activo | solo junto con una venta, anulación o pago nuevo   |
//  | (otras)         | nadie  | nadie                                              |
//
//  Los scripts de administración (seed, reset, backup, restore) usan
//  firebase-admin con cuenta de servicio y no pasan por estas reglas.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers de sesión y rol (1 lectura: perfiles/{uid})
    // ------------------------------------------------------------------
    function autenticado() {
      return request.auth != null;
    }

    function ruta(coleccion, id) {
      return /databases/$(database)/documents/$(coleccion)/$(id);
    }

    function perfilActual() {
      return get(ruta('perfiles', request.auth.uid)).data;
    }

    function perfilEsAdmin(p) {
      return p.rol == 'admin' && p.activo == true;
    }

    // Usuario con perfil aprobado por el admin. TODA colección de datos parte
    // de esta función (o de esAdmin, que también exige activo == true): un
    // perfil pendiente o desactivado solo puede leer su propio perfil.
    // Si el perfil no existe, get() falla y la regla deniega.
    function esUsuarioActivo() {
      return autenticado() && perfilActual().activo == true;
    }

    function esAdmin() {
      return autenticado() && perfilEsAdmin(perfilActual());
    }

    function rolValido(rol) {
      return rol in ['admin', 'vendedor'];
    }

    // ------------------------------------------------------------------
    // Helpers de validación
    // ------------------------------------------------------------------
    function esTextoOpcional(v) {
      return v == null || v is string;
    }

    function esNumeroOpcional(v) {
      return v == null || (v is number && v >= 0);
    }

    function esEnteroNoNegativo(v) {
      return v is int && v >= 0;
    }

    function exactamente(d, campos) {
      return d.keys().hasOnly(campos) && d.keys().hasAll(campos);
    }

    function cambiaSolo(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // Fecha YYYY-MM-DD en hora de Lima (UTC-5, sin horario de verano)
    function fechaLima(t) {
      let l = t - duration.value(5, 'h');
      return string(l.year()) + '-' + (l.month() < 10 ? '0' : '') + string(l.month())
        + '-' + (l.day() < 10 ? '0' : '') + string(l.day());
    }

    // Tolera 15 minutos de diferencia con el reloj del celular cerca de medianoche
    function esDiaDeHoy(dia) {
      return dia == fechaLima(request.time)
        || dia == fechaLima(request.time - duration.value(15, 'm'))
        || dia == fechaLima(request.time + duration.value(15, 'm'));
    }

    // ==================================================================
    // perfiles/{uid}
    // ==================================================================
    match /perfiles/{uid} {
      // Cada usuario lee su propio perfil (para saber si fue aprobado);
      // los demás perfiles solo los leen usuarios activos.
      allow read: if autenticado() && (request.auth.uid == uid || esUsuarioActivo());

      // Un usuario solo puede crear SU perfil, como vendedor e INACTIVO
      // (pendiente de aprobación). Solo el admin crea perfiles activos.
      allow create: if autenticado()
        && request.resource.data.keys().hasAll(['nombre', 'email', 'rol', 'activo'])
        && request.resource.data.nombre is string
        && request.resource.data.email is string
        && rolValido(request.resource.data.rol)
        && request.resource.data.activo is bool
        && (
          (request.auth.uid == uid && request.resource.data.rol == 'vendedor' && request.resource.data.activo == false)
          || esAdmin()
        );

      // El usuario solo cambia su nombre. El admin cambia nombre, rol y activo,
      // pero no puede quitarse el rol ni desactivarse a sí mismo.
      allow update: if autenticado() && (
          (request.auth.uid == uid && cambiaSolo(['nombre', 'actualizadoEn']))
          || (
            esAdmin()
            && cambiaSolo(['nombre', 'rol', 'activo', 'actualizadoEn'])
            && rolValido(request.resource.data.rol)
            && request.resource.data.activo is bool
            && (request.auth.uid != uid || (request.resource.data.rol == 'admin' && request.resource.data.activo == true))
          )
        );

      allow delete: if esAdmin() && request.auth.uid != uid;
    }

    // ==================================================================
    // categorias/{id} — leen usuarios activos; escribe el admin
    // ==================================================================
    function categoriaValida(d) {
      return d.keys().hasOnly(['nombre', 'icono', 'orden'])
        && d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 60
        && d.icono is string
        && d.orden is number;
    }

    match /categorias/{id} {
      allow read: if esUsuarioActivo();
      allow create, update: if esAdmin() && categoriaValida(request.resource.data);
      allow delete: if esAdmin();
    }

    // ==================================================================
    // STOCK (productos y materiales)
    //   El stock SOLO cambia junto con un movimiento NUEVO del kardex creado
    //   en la misma transacción: el ítem guarda ultimoMovimientoId y ese
    //   movimiento debe tener el mismo ítem, stockAnterior = stock previo y
    //   stockNuevo = stock nuevo. Quién puede crear cada tipo de movimiento
    //   (venta, anulación, ingreso, salida, ajuste) se decide en /movimientos.
    // ==================================================================

    // ¿El movimiento es nuevo en esta transacción? (1 lectura)
    //   - salida por venta: la venta no existía antes
    //   - entrada por anulación: la venta no estaba cancelada antes
    //   - resto: el documento del movimiento no existía antes
    function movimientoEsNuevo(movId, mov) {
      return mov.ventaId is string
        ? (mov.tipo == 'salida'
            ? !exists(ruta('ventas', mov.ventaId))
            : get(ruta('ventas', mov.ventaId)).data.estadoEntrega != 'cancelado')
        : !exists(ruta('movimientos', movId));
    }

    // 2 lecturas: movimientos/{movId} (después) + la de movimientoEsNuevo
    function stockConMovimiento(itemTipo, itemId, stockAnterior) {
      let nuevo = request.resource.data;
      let movId = nuevo.ultimoMovimientoId;
      let mov = getAfter(ruta('movimientos', movId)).data;
      return movId is string
        && mov.itemTipo == itemTipo
        && mov.itemId == itemId
        && mov.stockAnterior == stockAnterior
        && mov.stockNuevo == nuevo.stock
        && mov.usuarioId == request.auth.uid
        && movimientoEsNuevo(movId, mov);
    }

    // ==================================================================
    // productos/{id}
    //   Leen usuarios activos. El admin crea, edita y borra, pero el stock
    //   solo cambia con movimiento (venta, anulación, ajuste o stock inicial).
    //   El vendedor solo toca stock/ultimoMovimientoId dentro de una venta.
    // ==================================================================
    function productoValido(d) {
      return d.keys().hasOnly(['nombre', 'descripcion', 'categoriaId', 'categoriaNombre', 'precio', 'costo',
                               'stock', 'stockMinimo', 'fotoUrl', 'activo', 'creadoEn', 'actualizadoEn',
                               'ultimaVentaId', 'ultimoMovimientoId'])
        && d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 120
        && esTextoOpcional(d.descripcion)
        && esTextoOpcional(d.categoriaId)
        && esTextoOpcional(d.categoriaNombre)
        && d.precio is number && d.precio >= 0
        && esNumeroOpcional(d.costo)
        && esEnteroNoNegativo(d.stock)
        && esEnteroNoNegativo(d.stockMinimo)
        && esTextoOpcional(d.fotoUrl)
        && d.activo is bool;
    }

    match /productos/{id} {
      allow read: if esUsuarioActivo();
      allow delete: if esAdmin();
      allow create: if esAdmin() && productoValido(request.resource.data)
        && (request.resource.data.stock == 0 || stockConMovimiento('producto', id, 0));
      allow update: if productoValido(request.resource.data) && (
          request.resource.data.stock == resource.data.stock
            ? esAdmin()
            : (
              stockConMovimiento('producto', id, resource.data.stock)
              && (cambiaSolo(['stock', 'ultimoMovimientoId', 'actualizadoEn']) || esAdmin())
            )
        );
    }

    // ==================================================================
    // proveedores/{id} — leen usuarios activos; escribe el admin
    // ==================================================================
    function proveedorValido(d) {
      return d.keys().hasOnly(['nombre', 'telefono', 'contacto', 'direccion', 'notas', 'creadoEn', 'actualizadoEn'])
        && d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 100
        && esTextoOpcional(d.telefono)
        && esTextoOpcional(d.contacto)
        && esTextoOpcional(d.direccion)
        && esTextoOpcional(d.notas);
    }

    match /proveedores/{id} {
      allow read: if esUsuarioActivo();
      allow create, update: if esAdmin() && proveedorValido(request.resource.data);
      allow delete: if esAdmin();
    }

    // ==================================================================
    // materiales/{id}
    //   Leen usuarios activos. El admin crea, edita y borra. El stock solo
    //   cambia con movimiento: ingreso o salida (admin y vendedor) o ajuste
    //   (admin). En un ingreso, ultimoCosto solo puede tomar el costo del
    //   movimiento.
    // ==================================================================
    function materialValido(d) {
      return d.keys().hasOnly(['nombre', 'tipo', 'color', 'espesorMm', 'unidad', 'stock', 'stockMinimo', 'ultimoCosto',
                               'proveedorId', 'proveedorNombre', 'creadoEn', 'actualizadoEn', 'ultimoMovimientoId'])
        && d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 120
        && d.tipo in ['plancha', 'tapacanto', 'bisagra', 'corredera', 'tornilleria', 'otro']
        && esTextoOpcional(d.color)
        && esNumeroOpcional(d.espesorMm)
        && d.unidad is string && d.unidad.size() >= 1 && d.unidad.size() <= 20
        && d.stock is number && d.stock >= 0
        && d.stockMinimo is number && d.stockMinimo >= 0
        && esNumeroOpcional(d.ultimoCosto)
        && esTextoOpcional(d.proveedorId)
        && esTextoOpcional(d.proveedorNombre);
    }

    function ultimoCostoDelMovimiento() {
      let nuevo = request.resource.data;
      return nuevo.get('ultimoCosto', null) == resource.data.get('ultimoCosto', null)
        || nuevo.ultimoCosto == getAfter(ruta('movimientos', nuevo.ultimoMovimientoId)).data.costoUnitario;
    }

    match /materiales/{id} {
      allow read: if esUsuarioActivo();
      allow delete: if esAdmin();
      allow create: if esAdmin() && materialValido(request.resource.data)
        && (request.resource.data.stock == 0 || stockConMovimiento('material', id, 0));
      allow update: if materialValido(request.resource.data) && (
          request.resource.data.stock == resource.data.stock
            ? esAdmin()
            : (
              stockConMovimiento('material', id, resource.data.stock)
              && (
                (cambiaSolo(['stock', 'ultimoCosto', 'ultimoMovimientoId', 'actualizadoEn']) && ultimoCostoDelMovimiento())
                || esAdmin()
              )
            )
        );
    }

    // ==================================================================
    // clientes/{id} — usuarios activos leen, crean y actualizan
    // ==================================================================
    function clienteValido(d) {
      return d.keys().hasOnly(['nombre', 'telefono', 'direccion', 'creadoEn', 'ultimaCompraEn', 'actualizadoEn'])
        && d.nombre is string && d.nombre.size() >= 1 && d.nombre.size() <= 100
        && esTextoOpcional(d.telefono)
        && esTextoOpcional(d.direccion);
    }

    match /clientes/{id} {
      allow read: if esUsuarioActivo();
      allow create, update: if esUsuarioActivo() && clienteValido(request.resource.data);
      allow delete: if esAdmin();
    }

    // ==================================================================
    // ventas/{ventaId}
    //   Crear: usuario activo, a su nombre, con fecha del servidor, montos en
    //   céntimos cuadrados, y en la MISMA transacción el contador de boletas
    //   y el resumen del día deben apuntar a esta venta.
    //   Actualizar: el vendedor avanza el estado de entrega; solo el admin cancela.
    //   Nunca se borran.
    // ==================================================================
    function ventaCampos() {
      return ['numeroBoleta', 'codigoBoleta', 'clienteId', 'clienteNombre', 'clienteTelefono', 'vendedorId',
              'vendedorNombre', 'items', 'metodoPago', 'subtotalCent', 'descuentoCent', 'deliveryCent', 'totalCent',
              'costoTotalCent', 'unidades', 'deliveryDireccion', 'fechaEntrega', 'estadoEntrega', 'notas', 'fecha',
              'dia', 'actualizadoEn', 'canceladaEn', 'canceladaPor', 'canceladaPorNombre'];
    }

    function ventaMontosValidos(v) {
      return esEnteroNoNegativo(v.subtotalCent)
        && esEnteroNoNegativo(v.descuentoCent)
        && esEnteroNoNegativo(v.deliveryCent)
        && esEnteroNoNegativo(v.totalCent)
        && esEnteroNoNegativo(v.costoTotalCent)
        && v.unidades is int && v.unidades > 0
        && v.descuentoCent <= v.subtotalCent
        && v.totalCent == v.subtotalCent - v.descuentoCent + v.deliveryCent;
    }

    // MAX_ITEMS_VENTA = 5 (debe coincidir con src/services/ventas-core.ts)
    function ventaNuevaValida(ventaId) {
      let v = request.resource.data;
      let contador = getAfter(ruta('contadores', 'boletas')).data;
      let resumen = getAfter(ruta('resumen_diario', v.dia)).data;
      return exactamente(v, ventaCampos())
        && v.vendedorId == request.auth.uid
        && v.vendedorNombre is string
        && v.clienteNombre is string && v.clienteNombre.size() >= 1 && v.clienteNombre.size() <= 100
        && esTextoOpcional(v.clienteId)
        && esTextoOpcional(v.clienteTelefono)
        && v.items is list && v.items.size() >= 1 && v.items.size() <= 5
        && v.metodoPago in ['Yape', 'Plin', 'Efectivo', 'Tarjeta']
        && ventaMontosValidos(v)
        && esTextoOpcional(v.deliveryDireccion)
        && esTextoOpcional(v.notas)
        && ((v.fechaEntrega == null && v.estadoEntrega == 'entregado')
            || (v.fechaEntrega is string && v.estadoEntrega == 'pendiente'))
        && v.fecha == request.time
        && esDiaDeHoy(v.dia)
        && v.canceladaEn == null && v.canceladaPor == null && v.canceladaPorNombre == null
        && v.numeroBoleta is int
        && v.numeroBoleta == contador.ultimo
        && contador.ultimaVentaId == ventaId
        && v.codigoBoleta is string
        && v.codigoBoleta.matches(contador.serie + '-[0-9]{8}')
        && resumen.ultimaVentaId == ventaId;
    }

    match /ventas/{ventaId} {
      allow read: if esUsuarioActivo();
      allow delete: if false;

      allow create: if esUsuarioActivo() && ventaNuevaValida(ventaId);

      allow update: if (
          // Vendedor o admin: avanzar el estado de entrega (nunca a cancelado)
          esUsuarioActivo()
          && cambiaSolo(['estadoEntrega', 'actualizadoEn'])
          && resource.data.estadoEntrega != 'cancelado'
          && request.resource.data.estadoEntrega in ['pendiente', 'en_produccion', 'listo', 'entregado']
        ) || (
          // Admin: cancelar, en la misma transacción que descuenta el resumen
          esAdmin()
          && cambiaSolo(['estadoEntrega', 'canceladaEn', 'canceladaPor', 'canceladaPorNombre', 'actualizadoEn'])
          && resource.data.estadoEntrega != 'cancelado'
          && request.resource.data.estadoEntrega == 'cancelado'
          && request.resource.data.canceladaPor == request.auth.uid
          && request.resource.data.canceladaEn == request.time
          && getAfter(ruta('resumen_diario', resource.data.dia)).data.ultimaVentaId == ventaId
        );
    }

    // ==================================================================
    // movimientos/{movId} — kardex. Inmutable: no se edita ni se borra.
    //   Cada movimiento exige que su ítem quede, en la misma transacción, con
    //   stock == stockNuevo y ultimoMovimientoId == movId (y el ítem exige lo
    //   inverso), así ninguno de los dos puede escribirse sin el otro.
    //
    //   | tipo / ítem                 | quién         | id                       |
    //   | salida  producto (venta)    | activo        | {ventaId}_{productoId}   |
    //   | entrada producto (anulación)| admin         | {ventaId}_{productoId}_anul |
    //   | entrada material (ingreso)  | activo        | automático               |
    //   | salida  material (consumo)  | activo        | automático               |
    //   | ajuste  producto/material   | admin         | automático               |
    // ==================================================================
    function movimientoCampos() {
      return ['tipo', 'itemTipo', 'itemId', 'itemNombre', 'cantidad', 'costoUnitario', 'stockAnterior', 'stockNuevo',
              'ventaId', 'indiceItem', 'proveedorId', 'proveedorNombre', 'nota', 'usuarioId', 'usuarioNombre', 'fecha'];
    }

    function coleccionDeItem(itemTipo) {
      return itemTipo == 'producto' ? 'productos' : 'materiales';
    }

    // Campos opcionales: solo un consumo de material ligado a un pedido a medida los lleva
    function movimientoBaseValido(m) {
      return m.keys().hasAll(movimientoCampos())
        && m.keys().hasOnly(movimientoCampos().concat(['pedidoId', 'costoTotalCent']))
        && m.itemTipo in ['producto', 'material']
        && m.itemId is string && m.itemNombre is string
        && m.cantidad is number
        && m.stockAnterior is number && m.stockAnterior >= 0
        && m.stockNuevo is number && m.stockNuevo >= 0
        // Los productos se cuentan en unidades enteras
        && (m.itemTipo == 'material' || (m.cantidad is int && m.stockAnterior is int && m.stockNuevo is int))
        && esNumeroOpcional(m.costoUnitario)
        && esTextoOpcional(m.proveedorId)
        && esTextoOpcional(m.proveedorNombre)
        && esTextoOpcional(m.nota)
        && m.usuarioId == request.auth.uid
        && m.usuarioNombre is string
        && m.fecha == request.time;
    }

    // El ítem queda con este movimiento aplicado (1 lectura)
    function itemQuedaCon(m, movId) {
      let item = getAfter(ruta(coleccionDeItem(m.itemTipo), m.itemId)).data;
      return item.stock == m.stockNuevo && item.ultimoMovimientoId == movId;
    }

    function sinVenta(m) {
      return m.ventaId == null && m.indiceItem == null;
    }

    function sinPedido(m) {
      return m.get('pedidoId', null) == null && m.get('costoTotalCent', null) == null;
    }

    // Consumo de material usado en un pedido a medida (3 lecturas: material
    // antes, pedido después). El costo es cantidad × último costo del material
    // (céntimos, ±1 por redondeo) y el pedido lo suma en la misma transacción.
    function consumoDePedidoValido(m, movId) {
      let pedido = getAfter(ruta('pedidos', m.pedidoId)).data;
      let costo = m.costoUnitario;
      let exacto = costo == null ? 0 : m.cantidad * costo * 100;
      return m.pedidoId is string
        && m.tipo == 'salida'
        && m.costoTotalCent is int && m.costoTotalCent >= 0
        && costo == get(ruta('materiales', m.itemId)).data.get('ultimoCosto', null)
        && m.costoTotalCent - exacto <= 1 && m.costoTotalCent - exacto >= -1
        && pedido.ultimoMovimientoId == movId
        && pedido.etapa != 'cancelado';
    }

    // 3 lecturas: ventas/{v} (antes y después) y productos/{id} (después)
    function salidaPorVentaValida(movId) {
      let m = request.resource.data;
      let venta = getAfter(ruta('ventas', m.ventaId)).data;
      let item = venta.items[m.indiceItem];
      return movimientoBaseValido(m)
        && sinPedido(m)
        && m.itemTipo == 'producto'
        && m.ventaId is string
        && movId == m.ventaId + '_' + m.itemId
        && m.indiceItem is int && m.indiceItem >= 0
        && m.cantidad > 0
        && !exists(ruta('ventas', m.ventaId))
        && venta.vendedorId == request.auth.uid
        && item.productoId == m.itemId
        && item.cantidad == m.cantidad
        && m.stockNuevo == m.stockAnterior - m.cantidad
        && itemQuedaCon(m, movId);
    }

    function entradaPorAnulacionValida(movId) {
      let m = request.resource.data;
      return movimientoBaseValido(m)
        && sinPedido(m)
        && m.itemTipo == 'producto'
        && m.ventaId is string
        && movId == m.ventaId + '_' + m.itemId + '_anul'
        && m.cantidad > 0
        && m.stockNuevo == m.stockAnterior + m.cantidad
        && getAfter(ruta('ventas', m.ventaId)).data.estadoEntrega == 'cancelado'
        && itemQuedaCon(m, movId);
    }

    // Ingreso (entrada) o consumo (salida) de material: admin y vendedor
    function movimientoMaterialValido(movId) {
      let m = request.resource.data;
      return movimientoBaseValido(m)
        && m.itemTipo == 'material'
        && sinVenta(m)
        && m.cantidad > 0
        && (
          (m.tipo == 'entrada' && m.stockNuevo == m.stockAnterior + m.cantidad && sinPedido(m))
          || (m.tipo == 'salida' && m.stockNuevo == m.stockAnterior - m.cantidad
              && m.proveedorId == null && m.proveedorNombre == null
              && (sinPedido(m) || consumoDePedidoValido(m, movId)))
        )
        && itemQuedaCon(m, movId);
    }

    // Ajuste (solo admin): cantidad = diferencia, con motivo obligatorio
    function ajusteValido(movId) {
      let m = request.resource.data;
      return movimientoBaseValido(m)
        && sinVenta(m)
        && sinPedido(m)
        && m.cantidad != 0
        && m.cantidad == m.stockNuevo - m.stockAnterior
        && m.nota is string && m.nota.size() >= 3 && m.nota.size() <= 200
        && m.proveedorId == null && m.proveedorNombre == null
        && itemQuedaCon(m, movId);
    }

    match /movimientos/{movId} {
      allow read: if esUsuarioActivo();
      allow update, delete: if false;
      allow create: if
        (request.resource.data.tipo == 'salida' && request.resource.data.ventaId is string
          && salidaPorVentaValida(movId))
        || (request.resource.data.tipo == 'entrada' && request.resource.data.ventaId is string
          && esAdmin() && entradaPorAnulacionValida(movId))
        || (request.resource.data.tipo in ['entrada', 'salida'] && request.resource.data.ventaId == null
          && esUsuarioActivo() && movimientoMaterialValido(movId))
        || (request.resource.data.tipo == 'ajuste'
          && esAdmin() && ajusteValido(movId));
    }

    // ==================================================================
    // contadores/boletas y contadores/pedidos — correlativos
    //   Solo suben de 1 en 1 y solo junto con la venta / el pedido que recibe
    //   ese número (1 lectura). Un documento antiguo nunca tiene el número
    //   siguiente, así que no hace falta verificar que sea nuevo.
    //   El admin puede cambiar la serie (B001, B002... / P).
    // ==================================================================
    function contadorSube(campoId) {
      let c = request.resource.data;
      return exactamente(c, ['serie', 'ultimo', campoId])
        && c.serie is string
        && c.ultimo == (resource == null ? 0 : resource.data.ultimo) + 1
        && (resource == null || c.serie == resource.data.serie);
    }

    match /contadores/{id} {
      allow read: if esUsuarioActivo();
      allow delete: if false;

      allow create, update: if (
          id == 'boletas' && contadorSube('ultimaVentaId')
          && getAfter(ruta('ventas', request.resource.data.ultimaVentaId)).data.numeroBoleta == request.resource.data.ultimo
        ) || (
          id == 'pedidos' && contadorSube('ultimoPedidoId')
          && getAfter(ruta('pedidos', request.resource.data.ultimoPedidoId)).data.numero == request.resource.data.ultimo
        ) || (
          resource != null && esAdmin()
          && cambiaSolo(['serie'])
          && request.resource.data.serie is string && request.resource.data.serie.size() <= 8
        );
    }

    // ==================================================================
    // resumen_diario/{dia} — totales por día (céntimos), para Inicio y Reportes
    //   Venta: suma exactamente los montos de una venta NUEVA de ese día.
    //   Anulación (admin): resta exactamente los montos de la venta cancelada.
    // ==================================================================
    function resumenCampos() {
      return ['dia', 'numVentas', 'totalCent', 'costoCent', 'unidades', 'porMetodoCent', 'pagosPedidosCent',
              'pagosPedidosPorMetodoCent', 'ultimaVentaId', 'ultimoPago', 'actualizadoEn'];
    }

    function cerosPorMetodo() {
      return { 'Yape': 0, 'Plin': 0, 'Efectivo': 0, 'Tarjeta': 0 };
    }

    // Resúmenes creados antes de la fase 6 no tienen el desglose de pagos por método
    function pagosPorMetodoPrevio(p) {
      return p.get('pagosPedidosPorMetodoCent', cerosPorMetodo());
    }

    function resumenPrevio(dia) {
      return resource == null
        ? { 'dia': dia, 'numVentas': 0, 'totalCent': 0, 'costoCent': 0, 'unidades': 0,
            'porMetodoCent': cerosPorMetodo(), 'pagosPedidosCent': 0,
            'pagosPedidosPorMetodoCent': cerosPorMetodo(), 'ultimaVentaId': null, 'ultimoPago': null }
        : resource.data;
    }

    // signo = 1 suma la venta, -1 la resta
    function resumenAplicaVenta(r, p, v, signo) {
      return exactamente(r, resumenCampos())
        && r.numVentas == p.numVentas + signo
        && r.totalCent == p.totalCent + signo * v.totalCent
        && r.costoCent == p.costoCent + signo * v.costoTotalCent
        && r.unidades == p.unidades + signo * v.unidades
        && r.pagosPedidosCent == p.pagosPedidosCent
        && r.pagosPedidosPorMetodoCent == pagosPorMetodoPrevio(p)
        && r.ultimoPago == p.get('ultimoPago', null)
        && r.porMetodoCent.diff(p.porMetodoCent).affectedKeys().hasOnly([v.metodoPago])
        && r.porMetodoCent[v.metodoPago] == p.porMetodoCent[v.metodoPago] + signo * v.totalCent;
    }

    // ¿El pago en pedidos/{id}.pagos[indice] es nuevo en esta transacción? (2 lecturas)
    function pagoEsNuevo(rutaPedido, indice) {
      return !exists(rutaPedido) ? indice == 0 : get(rutaPedido).data.pagos.size() == indice;
    }

    // Pago de pedido a medida: suma exactamente su monto a pagosPedidosCent
    // y no toca los totales de ventas (3 lecturas: pedido antes y después).
    function resumenSumaPago(dia) {
      let r = request.resource.data;
      let p = resumenPrevio(dia);
      let ref = r.ultimoPago;
      let rutaPedido = ruta('pedidos', ref.pedidoId);
      let pago = getAfter(rutaPedido).data.pagos[ref.indice];
      return exactamente(r, resumenCampos())
        && r.dia == dia
        && ref.keys().hasOnly(['pedidoId', 'indice'])
        && ref.pedidoId is string && ref.indice is int && ref.indice >= 0
        && pagoEsNuevo(rutaPedido, ref.indice)
        && pago.dia == dia
        && pago.usuarioId == request.auth.uid
        && r.pagosPedidosCent == p.pagosPedidosCent + pago.montoCent
        && r.pagosPedidosPorMetodoCent.diff(pagosPorMetodoPrevio(p)).affectedKeys().hasOnly([pago.metodo])
        && r.pagosPedidosPorMetodoCent[pago.metodo] == pagosPorMetodoPrevio(p)[pago.metodo] + pago.montoCent
        && r.numVentas == p.numVentas
        && r.totalCent == p.totalCent
        && r.costoCent == p.costoCent
        && r.unidades == p.unidades
        && r.porMetodoCent == p.porMetodoCent
        && r.ultimaVentaId == p.get('ultimaVentaId', null);
    }

    // 2 lecturas: ventas/{v} (antes y después)
    function resumenSumaVenta(dia) {
      let r = request.resource.data;
      let v = getAfter(ruta('ventas', r.ultimaVentaId)).data;
      return r.dia == dia
        && v.dia == dia
        && v.vendedorId == request.auth.uid
        && !exists(ruta('ventas', r.ultimaVentaId))
        && resumenAplicaVenta(r, resumenPrevio(dia), v, 1);
    }

    function resumenRestaAnulacion(dia) {
      let r = request.resource.data;
      let antes = get(ruta('ventas', r.ultimaVentaId)).data;
      let despues = getAfter(ruta('ventas', r.ultimaVentaId)).data;
      return resource != null
        && r.dia == dia
        && antes.dia == dia
        && antes.estadoEntrega != 'cancelado'
        && despues.estadoEntrega == 'cancelado'
        && resumenAplicaVenta(r, resource.data, antes, -1);
    }

    match /resumen_diario/{dia} {
      allow read: if esUsuarioActivo();
      allow delete: if false;
      allow create, update: if (
          request.resource.data.numVentas == resumenPrevio(dia).numVentas + 1 && resumenSumaVenta(dia)
        ) || (
          request.resource.data.numVentas == resumenPrevio(dia).numVentas - 1 && esAdmin() && resumenRestaAnulacion(dia)
        ) || (
          request.resource.data.numVentas == resumenPrevio(dia).numVentas
          && request.resource.data.pagosPedidosCent > resumenPrevio(dia).pagosPedidosCent
          && esUsuarioActivo() && resumenSumaPago(dia)
        );
    }

    // ==================================================================
    // pedidos/{id} — pedidos a medida
    //   Crear: usuario activo, etapa "cotizado", correlativo P-0001 en la misma
    //   transacción y, si trae adelanto, el resumen del día debe registrarlo.
    //   Actualizar (un tipo de cambio por escritura):
    //     - etapa: avanzar/retroceder (activo) o cancelar (admin), +1 historial
    //     - pago: +1 pago, pagado/saldo cuadrados y sumado al resumen del día
    //     - consumo de material: suma el costo de un movimiento nuevo
    //     - datos: descripción, medidas, entrega (activo); precio solo admin
    //   Nunca se borran. Un pedido cancelado ya no cambia.
    // ==================================================================
    function pedidoCampos() {
      return ['numero', 'codigo', 'clienteId', 'clienteNombre', 'clienteTelefono', 'descripcion', 'medidas',
              'materialColor', 'notas', 'precioCent', 'pagadoCent', 'saldoCent', 'costoMaterialesCent', 'etapa',
              'historialEtapas', 'pagos', 'fechaEntrega', 'vendedorId', 'vendedorNombre', 'creadoEn',
              'actualizadoEn', 'ultimoMovimientoId'];
    }

    function etapaValida(e) {
      return e in ['cotizado', 'corte', 'enchapado', 'armado', 'entrega', 'entregado', 'cancelado'];
    }

    // Fechas dentro de arreglos (no admiten serverTimestamp): ±15 min del servidor
    function fechaCercana(t) {
      return t is timestamp
        && t > request.time - duration.value(15, 'm')
        && t < request.time + duration.value(15, 'm');
    }

    function pagoValido(pago) {
      return exactamente(pago, ['montoCent', 'metodo', 'fecha', 'dia', 'usuarioId', 'usuarioNombre', 'nota'])
        && pago.montoCent is int && pago.montoCent > 0
        && pago.metodo in ['Yape', 'Plin', 'Efectivo', 'Tarjeta']
        && fechaCercana(pago.fecha)
        && esDiaDeHoy(pago.dia)
        && pago.usuarioId == request.auth.uid
        && pago.usuarioNombre is string
        && esTextoOpcional(pago.nota);
    }

    function historialValido(h, etapa) {
      return exactamente(h, ['etapa', 'fecha', 'usuarioId', 'usuarioNombre', 'nota'])
        && h.etapa == etapa
        && fechaCercana(h.fecha)
        && h.usuarioId == request.auth.uid
        && h.usuarioNombre is string
        && esTextoOpcional(h.nota);
    }

    // diasPago es opcional porque los pedidos de la fase 5 no lo tienen
    function pedidoDatosValidos(d) {
      return d.keys().hasAll(pedidoCampos())
        && d.keys().hasOnly(pedidoCampos().concat(['diasPago']))
        && d.get('diasPago', []) is list
        && d.clienteNombre is string && d.clienteNombre.size() >= 1 && d.clienteNombre.size() <= 100
        && esTextoOpcional(d.clienteId)
        && esTextoOpcional(d.clienteTelefono)
        && d.descripcion is string && d.descripcion.size() >= 3 && d.descripcion.size() <= 500
        && esTextoOpcional(d.medidas)
        && esTextoOpcional(d.materialColor)
        && esTextoOpcional(d.notas)
        && esTextoOpcional(d.fechaEntrega)
        && d.precioCent is int && d.precioCent > 0
        && esEnteroNoNegativo(d.pagadoCent)
        && d.pagadoCent <= d.precioCent
        && d.saldoCent == d.precioCent - d.pagadoCent
        && esEnteroNoNegativo(d.costoMaterialesCent)
        && etapaValida(d.etapa)
        && d.historialEtapas is list
        && d.pagos is list;
    }

    // 3 lecturas: perfil, contador y (si hay adelanto) resumen del día
    function pedidoNuevoValido(id) {
      let d = request.resource.data;
      let contador = getAfter(ruta('contadores', 'pedidos')).data;
      return pedidoDatosValidos(d)
        && d.vendedorId == request.auth.uid
        && d.vendedorNombre is string
        && d.creadoEn == request.time
        && d.etapa == 'cotizado'
        && d.historialEtapas.size() == 1
        && historialValido(d.historialEtapas[0], 'cotizado')
        && d.costoMaterialesCent == 0
        && d.ultimoMovimientoId == null
        && d.numero is int
        && d.numero == contador.ultimo
        && contador.ultimoPedidoId == id
        && d.codigo is string && d.codigo.matches(contador.serie + '-[0-9]{4,}')
        && d.diasPago == (d.pagos.size() == 0 ? [] : [d.pagos[0].dia])
        && (
          d.pagos.size() == 0
            ? d.pagadoCent == 0
            : (
              d.pagos.size() == 1
              && pagoValido(d.pagos[0])
              && d.pagadoCent == d.pagos[0].montoCent
              && getAfter(ruta('resumen_diario', d.pagos[0].dia)).data.ultimoPago == { 'pedidoId': id, 'indice': 0 }
            )
        );
    }

    function pedidoCambiaEtapa() {
      let n = request.resource.data;
      let o = resource.data;
      let total = n.historialEtapas.size();
      return cambiaSolo(['etapa', 'historialEtapas', 'actualizadoEn'])
        && n.etapa != o.etapa
        && total == o.historialEtapas.size() + 1
        && n.historialEtapas[0:total - 1] == o.historialEtapas
        && historialValido(n.historialEtapas[total - 1], n.etapa)
        && (n.etapa == 'cancelado' ? esAdmin() : esUsuarioActivo());
    }

    // 2 lecturas: perfil y resumen del día (después)
    function pedidoRegistraPago(id) {
      let n = request.resource.data;
      let o = resource.data;
      let total = n.pagos.size();
      let pago = n.pagos[total - 1];
      let dias = o.get('diasPago', []);
      return cambiaSolo(['pagos', 'pagadoCent', 'saldoCent', 'diasPago', 'actualizadoEn'])
        && esUsuarioActivo()
        && n.get('diasPago', []) == (dias.hasAny([pago.dia]) ? dias : dias.concat([pago.dia]))
        && total == o.pagos.size() + 1
        // (una porción vacía [0:0] no se puede comparar: el primer pago se trata aparte)
        && (total == 1 || n.pagos[0:total - 1] == o.pagos)
        && pagoValido(pago)
        && n.pagadoCent == o.pagadoCent + pago.montoCent
        && getAfter(ruta('resumen_diario', pago.dia)).data.ultimoPago == { 'pedidoId': id, 'indice': total - 1 };
    }

    // 2 lecturas: movimiento antes y después
    function pedidoSumaConsumo(id) {
      let n = request.resource.data;
      let movId = n.ultimoMovimientoId;
      let mov = getAfter(ruta('movimientos', movId)).data;
      return cambiaSolo(['costoMaterialesCent', 'ultimoMovimientoId', 'actualizadoEn'])
        && movId is string
        && !exists(ruta('movimientos', movId))
        && mov.pedidoId == id
        && mov.tipo == 'salida'
        && mov.itemTipo == 'material'
        && mov.usuarioId == request.auth.uid
        && n.costoMaterialesCent == resource.data.costoMaterialesCent + mov.costoTotalCent;
    }

    function pedidoEditaDatos() {
      return cambiaSolo(['clienteNombre', 'clienteTelefono', 'descripcion', 'medidas', 'materialColor', 'notas',
                         'fechaEntrega', 'precioCent', 'saldoCent', 'actualizadoEn'])
        && (request.resource.data.precioCent == resource.data.precioCent ? esUsuarioActivo() : esAdmin());
    }

    match /pedidos/{id} {
      allow read: if esUsuarioActivo();
      allow delete: if false;
      allow create: if esUsuarioActivo() && pedidoNuevoValido(id);
      allow update: if resource.data.etapa != 'cancelado'
        && pedidoDatosValidos(request.resource.data)
        && (pedidoCambiaEtapa() || pedidoRegistraPago(id) || pedidoSumaConsumo(id) || pedidoEditaDatos());
    }

    // ------------------------------------------------------------------
    // Cualquier otra colección: denegada. Si se agrega una nueva, toda
    // lectura/escritura debe partir de esUsuarioActivo() o esAdmin().
    // ------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
